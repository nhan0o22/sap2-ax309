# ALINX AX309 - XC6SLX9-2FTG256C, LVCMOS33
# This diagnostic shares the physical pin map with ax309.ucf, but has no
# generated SAP2 clock and therefore intentionally has no TS_CPU_CLK.
NET "CLK" LOC = "T8" | IOSTANDARD = LVCMOS33;
NET "CLK" TNM_NET = "CLK";
TIMESPEC "TS_CLK" = PERIOD "CLK" 20 ns HIGH 50%;

NET "RST" LOC = "L3" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "KEY1_N" LOC = "C3" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "KEY2_N" LOC = "D3" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "KEY3_N" LOC = "E4" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "KEY4_N" LOC = "E3" | IOSTANDARD = LVCMOS33 | PULLUP;

NET "LED[0]" LOC = "P4" | IOSTANDARD = LVCMOS33;
NET "LED[1]" LOC = "N5" | IOSTANDARD = LVCMOS33;
NET "LED[2]" LOC = "P5" | IOSTANDARD = LVCMOS33;
NET "LED[3]" LOC = "M6" | IOSTANDARD = LVCMOS33;

NET "SEG[0]" LOC = "C7" | IOSTANDARD = LVCMOS33;
NET "SEG[1]" LOC = "E6" | IOSTANDARD = LVCMOS33;
NET "SEG[2]" LOC = "C5" | IOSTANDARD = LVCMOS33;
NET "SEG[3]" LOC = "F7" | IOSTANDARD = LVCMOS33;
NET "SEG[4]" LOC = "D6" | IOSTANDARD = LVCMOS33;
NET "SEG[5]" LOC = "E7" | IOSTANDARD = LVCMOS33;
NET "SEG[6]" LOC = "D5" | IOSTANDARD = LVCMOS33;
NET "SEG[7]" LOC = "C6" | IOSTANDARD = LVCMOS33;
NET "SEL[0]" LOC = "D8" | IOSTANDARD = LVCMOS33;
NET "SEL[1]" LOC = "E8" | IOSTANDARD = LVCMOS33;
NET "SEL[2]" LOC = "F9" | IOSTANDARD = LVCMOS33;
NET "SEL[3]" LOC = "F10" | IOSTANDARD = LVCMOS33;
NET "SEL[4]" LOC = "E10" | IOSTANDARD = LVCMOS33;
NET "SEL[5]" LOC = "D9" | IOSTANDARD = LVCMOS33;
